# Copiá este archivo como .env para personalizar la configuración.
# Todas las variables son opcionales en desarrollo.

PORT=3000
# Origen permitido por CORS (el dev server de Vite)
FRONTEND_URL=http://localhost:5173

# Obligatorias cuando NODE_ENV=production
ACCESS_TOKEN_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
REFRESH_TOKEN_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio

# Ruta del archivo SQLite (por defecto: backend/.data/pymes.db)
# DB_STORAGE=./.data/pymes.db
